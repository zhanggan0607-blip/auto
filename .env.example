# =============================================================================
# 投标自动化系统环境变量配置模板
# 统一配置文件 - 后端与基础设施共用
# =============================================================================
# 使用说明:
#   1. 复制本文件为 .env: cp .env.example .env
#   2. 根据实际环境修改配置值
#   3. 生产环境必须更换所有标记为 "change-in-production" 的值
# =============================================================================

# ---- Django 核心配置 ----
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=your-secret-key-change-in-production-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# ---- 敏感数据加密 ----
# AES-256-GCM 加密密钥，至少32字符，生产环境必须更换
SENSITIVE_DATA_ENCRYPTION_KEY=your-32-char-encryption-key-here

# ---- 数据库配置 (PostgreSQL) ----
DB_NAME=auto
DB_USER=bid_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=prefer

# 数据库从库 (读写分离，可选)
DB_REPLICA_HOST=
DB_REPLICA_PORT=5432
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=

# ---- Redis 配置 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PASSWORD=

# ---- Celery 消息队列 ----
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ---- Milvus 向量数据库 ----
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me-in-production
MINIO_SECRET_KEY=change-me-in-production
MINIO_SECURE=false
MINIO_BUCKET_NAME=bid-documents

# ---- 阿里云 OCR ----
ALIYUN_OCR_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_OCR_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

# ---- 钉钉通知 ----
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your-token
DINGTALK_SECRET=your-dingtalk-secret

# ---- OpenClaw Agent 配置 ----
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_LLM_PROVIDER=ollama
OPENCLAW_LLM_BASE_URL=http://localhost:11434
OPENCLAW_MAIN_MODEL=qwen2.5:14b
OPENCLAW_CODE_MODEL=deepseek-coder-v2:lite
OPENCLAW_VISION_MODEL=qwen2.5-vl:7b
OPENCLAW_EMBEDDING_MODEL=bge-m3
OPENCLAW_MAX_AGENTS=100
OPENCLAW_SESSION_TIMEOUT=3600

# ---- Embedding 模型配置 ----
EMBEDDING_MODEL_TYPE=openai
OPENAI_API_KEY=your-openai-api-key

# ---- Ollama 配置 ----
OLLAMA_BASE_URL=http://localhost:11434

# ---- CORS 配置 ----
CORS_ALLOWED_ORIGINS=http://localhost:9081,http://localhost:8100,https://your-domain.com

# ---- 监控配置 ----
PROMETHEUS_ENABLED=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bid-auto

# ---- Grafana 配置 ----
GRAFANA_PASSWORD=change-me-in-production

# ---- 邮件配置 ----
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@qq.com
EMAIL_HOST_PASSWORD=your-email-password

# ---- 代理配置 (爬虫使用) ----
PROXY_ENABLED=false
