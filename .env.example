# =============================================================================
# 投标自动化系统环境变量配置模板
# 支持万人级并发部署
# =============================================================================

# Django配置
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_LOG_LEVEL=INFO

# 敏感数据加密密钥 (用于身份证号、银行账号等敏感数据加密)
# 必须设置为至少32字符的强密钥，生产环境必须更换
SENSITIVE_DATA_ENCRYPTION_KEY=your-encryption-key-at-least-32-chars

# 数据库配置 - 主库
DB_NAME=bid_auto
DB_USER=bid_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# 数据库配置 - 从库 (读写分离)
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5433
DB_REPLICA_USER=replica
DB_REPLICA_PASSWORD=your-replica-password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PASSWORD=your-redis-password

# Redis集群配置
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=redis-1:7000,redis-2:7001,redis-3:7002,redis-4:7003,redis-5:7004,redis-6:7005

# RabbitMQ配置
RABBITMQ_HOST=localhost
RABBITMQ_USER=bid_user
RABBITMQ_PASSWORD=your-rabbitmq-password

# Milvus向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530

# MinIO对象存储配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=bid-documents

# 阿里云OCR配置
ALIYUN_OCR_ACCESS_KEY_ID=your-access-key-id
ALIYUN_OCR_ACCESS_KEY_SECRET=your-access-key-secret

# 钉钉通知配置
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your-token
DINGTALK_SECRET=your-dingtalk-secret

# OpenClaw Agent配置
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_LLM_PROVIDER=ollama
OPENCLAW_LLM_BASE_URL=http://localhost:11434
OPENCLAW_MAIN_MODEL=qwen2.5:14b
OPENCLAW_CODE_MODEL=deepseek-coder-v2:lite
OPENCLAW_VISION_MODEL=qwen2.5-vl:7b
OPENCLAW_EMBEDDING_MODEL=bge-m3
OPENCLAW_MAX_AGENTS=100
OPENCLAW_SESSION_TIMEOUT=3600

# Embedding模型配置
EMBEDDING_MODEL_TYPE=openai
OPENAI_API_KEY=your-openai-api-key

# CORS配置
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://your-domain.com

# 安全配置
SECURE_SSL_REDIRECT=true

# 监控配置
PROMETHEUS_ENABLED=true

# Grafana配置
GRAFANA_PASSWORD=admin

# 压力测试配置
LOCUST_USERS=10000
LOCUST_SPAWN_RATE=100
LOCUST_HOST=http://localhost:8000

# 邮件配置
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@qq.com
EMAIL_HOST_PASSWORD=your-email-password

# 代理配置 (爬虫使用)
PROXY_ENABLED=false
PROXY_LIST=http://proxy1:8080,http://proxy2:8080
