{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "投标平台验证规则",
  "description": "前后端共享的验证规则定义，确保数据验证一致性",
  "definitions": {
    "credit_code": {
      "type": "string",
      "pattern": "^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$",
      "description": "统一社会信用代码验证：18位"
    },
    "phone": {
      "type": "string",
      "pattern": "^1[3-9]\\d{9}$",
      "description": "中国手机号验证"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "邮箱验证"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "URL验证"
    },
    "bank_account": {
      "type": "string",
      "minLength": 10,
      "maxLength": 30,
      "pattern": "^\\d+$",
      "description": "银行账号：10-30位数字"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).+$",
      "description": "密码：8-128位，包含大小写字母和数字"
    },
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "pattern": "^[a-zA-Z0-9_]+$",
      "description": "用户名：3-50位字母数字下划线"
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "description": "正整数"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "maximum": 999999999.99,
      "description": "价格：0-999999999.99"
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "百分比：0-100"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "日期：YYYY-MM-DD格式"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "description": "日期时间：ISO 8601格式"
    }
  },
  "entities": {
    "enterprise": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200,
        "required": true,
        "description": "企业名称"
      },
      "credit_code": {
        "$ref": "#/definitions/credit_code",
        "required": true,
        "description": "统一社会信用代码"
      },
      "contact_person": {
        "type": "string",
        "minLength": 2,
        "maxLength": 50,
        "required": true,
        "description": "联系人"
      },
      "contact_phone": {
        "$ref": "#/definitions/phone",
        "required": true,
        "description": "联系电话"
      },
      "contact_email": {
        "$ref": "#/definitions/email",
        "required": false,
        "description": "联系邮箱"
      },
      "bank_account": {
        "$ref": "#/definitions/bank_account",
        "required": false,
        "description": "银行账号"
      },
      "address": {
        "type": "string",
        "maxLength": 500,
        "required": false,
        "description": "企业地址"
      }
    },
    "tender": {
      "title": {
        "type": "string",
        "minLength": 5,
        "maxLength": 500,
        "required": true,
        "description": "招标标题"
      },
      "project_code": {
        "type": "string",
        "minLength": 5,
        "maxLength": 100,
        "required": true,
        "description": "项目编号"
      },
      "budget": {
        "$ref": "#/definitions/price",
        "required": false,
        "description": "预算金额"
      },
      "deadline_date": {
        "$ref": "#/definitions/date",
        "required": true,
        "description": "截止日期"
      },
      "region": {
        "type": "string",
        "maxLength": 100,
        "required": false,
        "description": "地区"
      },
      "category": {
        "type": "string",
        "maxLength": 100,
        "required": false,
        "description": "招标类别"
      }
    },
    "bid_record": {
      "tender": {
        "type": "integer",
        "minimum": 1,
        "required": true,
        "description": "招标ID"
      },
      "bid_price": {
        "$ref": "#/definitions/price",
        "required": true,
        "description": "投标金额"
      },
      "bid_date": {
        "$ref": "#/definitions/date",
        "required": true,
        "description": "投标日期"
      },
      "bid_code": {
        "type": "string",
        "maxLength": 100,
        "required": false,
        "description": "投标编号"
      },
      "win_probability": {
        "$ref": "#/definitions/percentage",
        "required": false,
        "description": "中标概率"
      },
      "competitor_count": {
        "type": "integer",
        "minimum": 0,
        "required": false,
        "description": "竞争对手数量"
      },
      "status": {
        "type": "string",
        "enum": ["draft", "submitted", "won", "lost", "withdrawn"],
        "required": true,
        "description": "投标状态"
      },
      "notes": {
        "type": "string",
        "maxLength": 2000,
        "required": false,
        "description": "备注"
      }
    },
    "user": {
      "username": {
        "$ref": "#/definitions/username",
        "required": true,
        "description": "用户名"
      },
      "email": {
        "$ref": "#/definitions/email",
        "required": true,
        "description": "邮箱"
      },
      "phone": {
        "$ref": "#/definitions/phone",
        "required": false,
        "description": "手机号"
      },
      "password": {
        "$ref": "#/definitions/password",
        "required": true,
        "description": "密码"
      },
      "real_name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 50,
        "required": false,
        "description": "真实姓名"
      }
    },
    "qualification": {
      "enterprise": {
        "type": "integer",
        "minimum": 1,
        "required": true,
        "description": "企业ID"
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200,
        "required": true,
        "description": "资质名称"
      },
      "level": {
        "type": "string",
        "enum": ["A级", "B级", "C级", "D级", "特级"],
        "required": false,
        "description": "资质等级"
      },
      "license_number": {
        "type": "string",
        "maxLength": 100,
        "required": false,
        "description": "证书编号"
      },
      "issue_date": {
        "$ref": "#/definitions/date",
        "required": false,
        "description": "发证日期"
      },
      "expiry_date": {
        "$ref": "#/definitions/date",
        "required": false,
        "description": "过期日期"
      }
    }
  }
}